{
  "name": "@digitaldefiance/node-rs-accelerate",
  "version": "0.1.0",
  "description": "High-performance Reed-Solomon error correction library optimized for Apple Silicon",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "yarn build:native && yarn build:ts",
    "build:native": "node-gyp rebuild",
    "build:asan": "node-gyp rebuild --binding=binding.asan.gyp",
    "build:ts": "tsc",
    "clean": "rm -rf dist build",
    "test": "jest",
    "test:properties": "jest --testPathPattern=properties",
    "test:integration": "jest --testPathPattern=integration",
    "test:stress": "jest --testPathPattern=stress",
    "test:memory": "./scripts/test-memory-leaks.sh",
    "test:memory:verbose": "./scripts/test-memory-leaks.sh --verbose",
    "test:memory:heap": "./scripts/test-memory-leaks.sh --heap",
    "test:memory:asan-only": "./scripts/test-memory-leaks.sh --asan-only",
    "benchmark": "node benchmarks/run.js",
    "prepare": "yarn build"
  },
  "keywords": [
    "reed-solomon",
    "error-correction",
    "erasure-coding",
    "apple-silicon",
    "metal",
    "accelerate",
    "galois-field"
  ],
  "author": "Digital Defiance",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "dependencies": {
    "node-addon-api": "^7.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "node-gyp": "^10.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digitaldefiance/node-rs-accelerate.git"
  }
}
